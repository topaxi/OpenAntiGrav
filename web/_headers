# Response headers for Cloudflare Pages (docs/tools/web.md, "Hosting"). GitHub
# Pages ignores this file and serves it as a plain file; the page works there
# without these headers.
#
# Cross-origin isolation: makes `crossOriginIsolated` true, which is what
# SharedArrayBuffer and wasm threads need. The page loads nothing from another
# origin, so require-corp blocks nothing it uses.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# pkg/<content hash>/ never changes under the same name (build-web.sh). The page's
# own files revalidate on every load instead: main.js names the pkg/ directory, so
# a cached main.js runs the previous deploy's module. Cloudflare gives a cached
# file the zone's browser TTL (4 hours) where nothing here says otherwise.
/pkg/*
  Cache-Control: public, max-age=31536000, immutable
/main.js
  Cache-Control: no-cache
/worker.js
  Cache-Control: no-cache
/fault.js
  Cache-Control: no-cache
/audio.js
  Cache-Control: no-cache
/audio-worklet.js
  Cache-Control: no-cache
/movie.js
  Cache-Control: no-cache
/style.css
  Cache-Control: no-cache

# The project's TOML Schemas (scripts/stage-schemas.sh). Editors and validators
# fetch them from other origins, and a schema may change within its major, so the
# lifetime is short. The index page and index.json beside them
# (scripts/gen-schema-index.py) keep their own types.
/mods/schemas/:major/*
  Content-Type: application/toml
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
