<?xml version="1.0"?>
<!-- Detonator on Wipeout Pulse, which ships no Detonator weapon table: this project's own, read in
     place of Pulse's race table in Detonator (oag_title::weapons::Weapons::detonator). The figures
     are chosen after Fury's (docs/gameplay/detonator-pulse.md, "The numbers"). The Mine's
     slowdown_time is 0 as Fury's is. Its timetodie, the Bomb's and Cannon's slowdown_time, the
     Cannon's damage_per_bullet and every absorb are there for the reader: Detonator spends none
     of them. -->
<WeaponStats>
	<Weapon type="Global"><Stats slowdown_limit="1.3" energy_recharge_per_stage="10"/></Weapon>
	<Weapon type="Mine"><Stats absorb="0" blastforce="0" blastradius="30" damage="10" slowdown_time="0" timetodie="20" trigger_radius="3" velocity_reduction="0.5"/></Weapon>
	<Weapon type="Bomb"><Stats absorb="0" blastforce="30" blastradius="40" damage="20" slowdown_time="0" trigger_radius="6" number_of_shots_to_destroy="4"/></Weapon>
	<Weapon type="Cannon"><Stats absorb="0" rounds="15" rate="10" damage_per_bullet="0" slowdown_time="0" num_rebounds="1"/></Weapon>
	<Weapon type="EMP"><Stats wave_time="2" speed="1" minNumPadsToCollectEMP="4" maxNumPadsToCollectEMP="8" minDistance="0.25" maxDistance="2"/></Weapon>
</WeaponStats>
