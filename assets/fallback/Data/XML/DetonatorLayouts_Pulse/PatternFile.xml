	<Cluster2 numOfObjects="1" type="0" percentageAcrossTrack="-2" distanceFromOriginalPosition="2"></Cluster2>
	<Cluster3 numOfObjects="1" type="0" percentageAcrossTrack="0" distanceFromOriginalPosition="4"></Cluster3>
	<Cluster4 numOfObjects="1" type="0" percentageAcrossTrack="2" distanceFromOriginalPosition="6"></Cluster4>
	<Cluster5 numOfObjects="1" type="0" percentageAcrossTrack="4" distanceFromOriginalPosition="8"></Cluster5>
</Pattern>
