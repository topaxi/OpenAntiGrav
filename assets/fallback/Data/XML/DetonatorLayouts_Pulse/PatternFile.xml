<?xml version="1.0"?>
<!-- Detonator on Wipeout Pulse, which ships no Detonator: this project's own pattern groups,
     chosen, not measured (docs/gameplay/detonator-pulse.md). Read by
     oag_tables::detonator_layout::parse_patterns. A cluster is a run of numOfObjects objects,
     distanceBetweenObjects track entries apart, percentageAcrossTrack lanes off the centre,
     starting distanceFromOriginalPosition entries past the group's base; object type 0 is a
     mine, 1 a bomb. -->
<Pattern stageToAppearFrom="1">
	<Cluster1 numOfObjects="4" distanceBetweenObjects="3" type="0" percentageAcrossTrack="0" distanceFromOriginalPosition="0"></Cluster1>
</Pattern>
<Pattern stageToAppearFrom="1">
	<Cluster1 numOfObjects="3" distanceBetweenObjects="4" type="0" percentageAcrossTrack="-3" distanceFromOriginalPosition="0"></Cluster1>
	<Cluster2 numOfObjects="3" distanceBetweenObjects="4" type="0" percentageAcrossTrack="3" distanceFromOriginalPosition="2"></Cluster2>
</Pattern>
<Pattern stageToAppearFrom="3">
