<?xml version="1.0" encoding="UTF-8"?>
<!-- Ships the PS3 PPU compiler-spec fix (ppc_64_32_ps3.cspec) and the Cell `lvlx`
     instruction (cell_lvlx.sinc) as an installable language, rather than root-owned edits
     to the Ghidra install.

     `slafile` is compiled by scripts/build-ghidra-ps3-scripts.sh: stock Ghidra's own
     ppc_64_isa_altivec_be.slaspec and its .sinc files, copied from the local install at
     build time, plus one `@include "cell_lvlx.sinc"` after altivec.sinc. Nothing of
     Ghidra's is tracked for it. `processorspec` is still reused by filename - Ghidra's
     SleighLanguageProvider falls back to an application-wide search by filename when a
     referenced file is not found beside this .ldefs, so an extension can point at another
     module's .pspec without vendoring it, as long as the filename is unique across the
     install (verified: ppc_64.pspec exists nowhere else on this machine).

     This needs its own language id: `PowerPC:BE:64:A2ALT-32addr` is already taken by stock
     Ghidra's entry, and Ghidra errors on a duplicate id rather than letting one override
     the other. Decompilation is otherwise identical to the stock language with
     scripts/patch-ghidra-ppc-cspec.sh applied - same pspec, ppc_64_32_ps3.cspec is that
     patched cspec verbatim (see its own header), and the sla differs from stock by the one
     constructor. The id and version are deliberately unchanged from the sla-less first
     cut of this language (2026-08-26): a program imported under it before the constructor
     landed still opens, with its `lvlx` sites still undefined until re-disassembled or
     reimported. See OpenAntiGrav's docs/reverse-engineering/toolchain.md#ps3.
-->
<language_definitions>
  <language processor="PowerPC"
            endian="big"
            size="32"
            variant="PowerISA-Altivec-64-32addr-PS3"
            version="1.7"
            slafile="ppc_64_isa_altivec_ps3.sla"
            processorspec="ppc_64.pspec"
            manualindexfile="../manuals/PowerISA.idx"
            id="PowerPC:BE:64:A2ALT-32addr-PS3">
    <description>Power ISA 3.0 Big Endian w/Altivec and 32-bit Addressing, PS3 PPU cspec (r2 unaffected) and Cell lvlx</description>
    <truncate_space space="ram" size="4"/>
    <compiler name="default" spec="ppc_64_32_ps3.cspec" id="default"/>
  </language>
</language_definitions>
