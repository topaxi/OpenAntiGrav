+// GDB remote-serial write watchpoints (Z2/z2 packets, see Emu/GDB.cpp).
+// Kept separate from the RPCS3_HAS_MEMORY_BREAKPOINTS machinery above: that
+// one (g_breakpoint_handler) matches only a write whose *start* address is
+// exactly a registered point, which is enough for the Qt debugger's memory
+// breakpoints but not for a GDB watchpoint, which must fire for a write to
+// *any* byte inside an arbitrary [addr, addr+len) range. g_gdb_watch_active
+// is a plain relaxed flag so the check costs one load-and-branch on every
+// guest write when no watchpoint is armed.
+extern atomic_t<bool> g_gdb_watch_active;
+bool gdb_watch_check_write(u32 addr, u32 size, ppu_thread* ppu);
