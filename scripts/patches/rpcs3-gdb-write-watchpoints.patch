 LOG_CHANNEL(GDB);
 
+// GDB write watchpoints (Z2/z2). See the comment on g_gdb_watch_active in
+// Emu/Memory/vm.h for why this doesn't reuse the Qt debugger's
+// g_breakpoint_handler: that one is keyed on a write's exact start address,
+// a GDB watchpoint has to fire on any write that overlaps [addr, addr+len).
+//
+// Like Z0 software breakpoints (ppu_breakpoint(), above), this only ever
+// fires under `PPU Decoder: Interpreter (static)`. The LLVM recompiler
+// emits stores directly into guest memory rather than going through
+// vm::write(), so there is nothing here to hook for it - matching the
+// existing, documented Z0 limitation rather than a new one.
+//
+// Build requirement: needs -DHAS_MEMORY_BREAKPOINTS=ON (off by default -
+// see the top-level CMakeLists.txt option of the same name). That flag
+// controls whether vm.h's write8()/write<T>() even take a ppu_thread*
+// parameter at all; without it, Z2/z2 still answer OK/parse correctly but
+// silently never fire, since there is no ppu_thread* to check a write
+// against - the same "already say OK unconditionally" shape Z0 already has
+// under the LLVM decoder. This also gates RPCS3's own pre-existing Qt
+// memory-breakpoint feature (g_breakpoint_handler below), so building with
+// it on is a strict improvement, not a Z2-specific requirement.
+namespace
+{
+	struct gdb_watch_range
+	{
+		u32 addr;
+		u32 len;
+	};
+
+	class gdb_watch_registry
+	{
+		mutable shared_mutex m_mutex;
+		std::vector<gdb_watch_range> m_watches;
+
+	public:
+		void add(u32 addr, u32 len)
+		{
+			std::lock_guard lock(m_mutex);
+
+			if (std::none_of(m_watches.begin(), m_watches.end(), [&](const gdb_watch_range& w)
+				{
+					return w.addr == addr && w.len == len;
+				}))
+			{
+				m_watches.push_back({addr, len});
+			}
+		}
+
+		void remove(u32 addr, u32 len)
+		{
+			std::lock_guard lock(m_mutex);
+
+			m_watches.erase(std::remove_if(m_watches.begin(), m_watches.end(), [&](const gdb_watch_range& w)
+				{
+					return w.addr == addr && w.len == len;
+				}), m_watches.end());
+		}
+
+		bool empty() const
+		{
+			std::lock_guard lock(m_mutex);
+			return m_watches.empty();
+		}
+
+		bool overlaps(u32 addr, u32 size) const
+		{
+			std::lock_guard lock(m_mutex);
+
+			for (const auto& w : m_watches)
+			{
+				const u64 write_end = u64{addr} + size;
+				const u64 watch_end = u64{w.addr} + w.len;
+
+				if (u64{addr} < watch_end && write_end > u64{w.addr})
+				{
+					return true;
+				}
+			}
+
+			return false;
+		}
+	};
+
+	gdb_watch_registry g_gdb_watches;
+}
+
+atomic_t<bool> g_gdb_watch_active{false};
+
+bool gdb_watch_check_write(u32 addr, u32 size, ppu_thread* ppu)
+{
+	// This is called unconditionally from every guest write in the
+	// interpreter (see vm.h). The "is anything armed" fast exit lives here,
+	// inside the callee, so it runs at genuine per-call runtime.
+	if (!ppu || !g_gdb_watch_active.load())
+	{
+		return false;
+	}
+
+	if (!g_gdb_watches.overlaps(addr, size))
+	{
+		return false;
+	}
+
+	GDB.success("Write watchpoint hit: %d byte(s) at 0x%x.", size, addr);
+
+	// Same pause mechanism ppubreak() (Emu/Cell/PPUInterpreter.cpp) uses for
+	// the Qt memory-breakpoint feature, and the same one ppu_break() (above,
+	// via check_state()) uses for a Z0 code breakpoint: set dbg_pause and let
+	// check_state() park the thread and notify the GDB server
+	// (Emu/CPU/CPUThread.cpp, gdb_server::pause_from()).
+	if (!ppu->state.test_and_set(cpu_flag::dbg_pause))
+	{
+		ppu->check_state();
+	}
+
+	return true;
+}
