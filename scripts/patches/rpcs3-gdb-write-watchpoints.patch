+	{
+		u32 addr = INVALID_PTR;
+		u32 len = 0;
+		sscanf_s(cmd.data.c_str(), "2,%x,%x", &addr, &len);
+		if (addr == INVALID_PTR || len == 0)
+		{
+			GDB.warning("Can't parse watchpoint remove request, data: '%s'.", cmd.data);
+			return send_cmd_ack("E01");
+		}
+		g_gdb_watches.remove(addr, len);
+		g_gdb_watch_active = !g_gdb_watches.empty();
+		GDB.success("Removed write watchpoint at 0x%x, length %d.", addr, len);
+		return send_cmd_ack("OK");
+	}
 	//other breakpoint types are not supported
 	return send_cmd_ack("");
 
