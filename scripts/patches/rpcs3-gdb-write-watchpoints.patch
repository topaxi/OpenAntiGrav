 	return send_cmd_ack("");
 }
@@ -899,6 +1040,22 @@ bool gdb_thread::cmd_remove_breakpoint(gdb_cmd& cmd)
 		ppu_breakpoint(addr, false);
 		return send_cmd_ack("OK");
 	}
+	//write watchpoint
