# Wipeout Pure's pause screen over a Time Trial on Vineta K (Feisar, Vector), played through our own menus: START pauses the
# race and opens the disc's own `InGame Main Menu`. `@OUT@` is the screenshot path `compare_menu.drive_command` fills in.
# Run with `--original-menu` (no PHOTO MODE row) and `--no-intro`.
boot
select racebox; press cross; until page=race
set race.mode=time_trial
select launch_race; press cross
until screen=picker within 3000
select "Vineta K"; press cross
until screen.id=ship-select
select Feisar; press cross
until stage=race within 6000
ticks 1480
press start
ticks 10
draw
screenshot @OUT@
quit
