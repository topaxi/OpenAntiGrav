# The track manifest beside a .glb: names and integer structure, see
# crates/trackfile/src/manifest.rs and docs/formats/track-file.md. Every
# float the race reads lives in the glb, never here. What this cannot say and
# stays the reader's: that a path or junction index is in range, and that the
# counts match what the glb holds.
#
# The schema is closed. A reader of this major tolerates a key it does not
# know and names it as unread (a file written against a later revision of this
# same v1 schema); the schema itself refuses it.

[toml-schema]
version = "1.0.0"

[types.toml-schema-reference]
type = "table"

[types.toml-schema-reference.location]
type = "string"
pattern = "/v1/track[.]tosd$"

[types.toml-schema-reference.version]
type = "string"
allowedvalues = ["1.0.0"]

[types.track]
type = "table"

[types.track.id]
type = "string"
minlength = 1

[types.track.title]
type = "string"

# The title whose disc the art borrows from (host textures, the sky), spelled
# as oag_source::layers::slug spells a title's name (a mod's `titles`
# vocabulary). Required when the art borrows (the reader's rule, not this
# schema's); on another title such a track runs as a Race Remix with this disc
# as the track source (ADR-0076, decision 13).
[types.track.host]
type = "string"
allowedvalues = ["wipeout-pulse", "wipeout-pure", "wipeout-hd", "wipeout-omega-collection", "wipeout-2048"]
optional = true

# The titles the author offers the track on, the same slugs; absent is every
# title.
[types.track.titles]
type = "array"
itemtype = "string"
optional = true

[types.track.glb]
type = "string"

[types.track.notes]
type = "array"
itemtype = "string"
optional = true

[types.path]
type = "table"

[types.path.points]
type = "integer"
min = 0

[types.path.entry]
type = "integer"
min = -1

[types.path.exit]
type = "integer"
min = -1

[types.path.max_spacing_bits]
type = "integer"
min = 0
max = 4294967295

# Path indices, -1 for none: primary then alternate.
[types.index-pair]
type = "array"
itemtype = "integer"
minlength = 2
maxlength = 2

[types.junction]
type = "table"

[types.junction.prev]
type = "types.index-pair"

[types.junction.next]
type = "types.index-pair"

[types.spline]
type = "table"

[types.spline.point_version]
type = "integer"
min = 0
max = 4294967295

[types.spline.path]
type = "array"
itemtype = "types.path"
optional = true

[types.spline.junction]
type = "array"
itemtype = "types.junction"
optional = true

[types.counts]
type = "table"

[types.counts.collision_nodes]
type = "integer"
min = 0

[types.counts.speedup_pads]
type = "integer"
min = 0

[types.counts.weapon_pads]
type = "integer"
min = 0

# Written only when the track has art (ADR-0076).
[types.counts.art_meshes]
type = "integer"
min = 0
optional = true

# Written only when the track has triggers (`oag/triggers` in the glb).
[types.counts.triggers]
type = "integer"
min = 0
optional = true

# The art section (ADR-0076). Its numbers are render-side only, so they are
# decimal here: nothing simulates them. A reader also takes `2` for `2.0`.
[types.number]
oneof = ["integer", "float"]

# The track's own properties for a simulation mod: name to number or bool (a
# bool reads as 1.0 or 0.0). The engine gives none a meaning; a string is
# refused. Written as a float widened from the f32 the race hands a mod, so it
# reads back exact.
[types.prop-value]
oneof = ["integer", "float", "boolean"]

[types.props]
type = "collection"
itemtype = "types.prop-value"
keypattern = "^.+$"

[types.vec3]
type = "array"
itemtype = "types.number"
minlength = 3
maxlength = 3

[types.sun]
type = "table"

# Unit vector from the scene towards the sun.
[types.sun.direction]
type = "types.vec3"

# Linear RGB.
[types.sun.colour]
type = "types.vec3"

[types.sun.intensity]
type = "types.number"

# Degrees; 0 is a point sun.
[types.sun.angular_diameter]
type = "types.number"

# Absent is true: an authored sun is the shadow light. A Pure export writes false.
[types.sun.shadows]
type = "boolean"
optional = true

# A light beyond the sun and the ambient. `kind` is `directional` in 1.x.
[types.light]
type = "table"

[types.light.kind]
type = "string"
allowedvalues = ["directional"]

# Unit vector from the scene towards the light.
[types.light.direction]
type = "types.vec3"

# Linear RGB.
[types.light.colour]
type = "types.vec3"

[types.light.intensity]
type = "types.number"

[types.lensflare]
type = "table"

# Overrides the sun's direction (unit, towards the flare).
[types.lensflare.direction]
type = "types.vec3"
optional = true

[types.lensflare.colour]
type = "types.vec3"
optional = true

# An index into the `[[art.texture]]` rows.
[types.lensflare.atlas]
type = "integer"
min = 0
optional = true

# The track's own sky (ADR-0076 decision 14), never together with `sky`: a
# camera-centred cube whose faces are texture rows (order +X, -X, +Y zenith,
# -Y nadir, +Z, -Z; -1 a face drawn as the gradient) and/or a gradient from
# `horizon` (eye level and below) to `zenith` (overhead), linear RGB. The
# reader checks what this cannot: one of the two forms is given, both colours
# come together, and a -1 face has the gradient.
[types.skybox]
type = "table"

[types.skybox.faces]
type = "array"
itemtype = "integer"
minlength = 6
maxlength = 6
optional = true

[types.skybox.zenith]
type = "types.vec3"
optional = true

[types.skybox.horizon]
type = "types.vec3"
optional = true

# A texture row is exactly one of the two: the author's own picture beside the
# manifest, or a host title's circuit texture named by entry and node name.
[types.image-texture]
type = "table"

[types.image-texture.image]
type = "string"
minlength = 1

[types.host-reference]
type = "table"

[types.host-reference.entry]
type = "string"
minlength = 1

[types.host-reference.name]
type = "string"
minlength = 1

[types.host-texture]
type = "table"

[types.host-texture.host]
type = "types.host-reference"

[types.texture]
oneof = ["types.image-texture", "types.host-texture"]

[types.art]
type = "table"

# A host circuit's `.vex` entry whose `Skycube` is drawn.
[types.art.sky]
type = "string"
minlength = 1
optional = true

[types.art.skybox]
type = "types.skybox"
optional = true

# Draw the flat-shaded collision (floor and walls) under the art; absent is
# false, the art alone (ADR-0076).
[types.art.draw_collision]
type = "boolean"
optional = true

# Linear RGB.
[types.art.ambient]
type = "types.vec3"
optional = true

[types.art.sun]
type = "types.sun"
optional = true

[types.art.lensflare]
type = "types.lensflare"
optional = true

[types.art.light]
type = "array"
itemtype = "types.light"
optional = true

[types.art.texture]
type = "array"
itemtype = "types.texture"
optional = true

[elements]

[elements.toml-schema]
type = "types.toml-schema-reference"

[elements.track]
type = "types.track"

[elements.spline]
type = "types.spline"

[elements.counts]
type = "types.counts"

[elements.props]
type = "types.props"
optional = true

[elements.art]
type = "types.art"
optional = true
