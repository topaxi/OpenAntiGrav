# The track manifest beside a .glb: names and integer structure, see
# crates/trackfile/src/manifest.rs and docs/formats/track-file.md. Every
# float the race reads lives in the glb, never here. What this cannot say and
# stays the reader's: that a path or junction index is in range, and that the
# counts match what the glb holds.
#
# The schema is closed. A reader of this major tolerates a key it does not
# know and names it as unread (a file written against a later revision of this
# same v1 schema); the schema itself refuses it.

[toml-schema]
version = "1.0.0"

[types.toml-schema-reference]
type = "table"

[types.toml-schema-reference.location]
type = "string"
pattern = "/v1/track[.]tosd$"

[types.toml-schema-reference.version]
type = "string"
allowedvalues = ["1.0.0"]

[types.track]
type = "table"

[types.track.id]
type = "string"
minlength = 1

[types.track.title]
type = "string"

[types.track.glb]
type = "string"

[types.track.notes]
type = "array"
itemtype = "string"
optional = true

[types.path]
type = "table"

[types.path.points]
type = "integer"
min = 0

[types.path.entry]
type = "integer"
min = -1

[types.path.exit]
type = "integer"
min = -1

[types.path.max_spacing_bits]
type = "integer"
min = 0
max = 4294967295

# Path indices, -1 for none: primary then alternate.
[types.index-pair]
type = "array"
itemtype = "integer"
minlength = 2
maxlength = 2

[types.junction]
type = "table"

[types.junction.prev]
type = "types.index-pair"

[types.junction.next]
type = "types.index-pair"

[types.spline]
type = "table"

[types.spline.point_version]
type = "integer"
min = 0
max = 4294967295

[types.spline.path]
type = "array"
itemtype = "types.path"
optional = true

[types.spline.junction]
type = "array"
itemtype = "types.junction"
optional = true

[types.counts]
type = "table"

[types.counts.collision_nodes]
type = "integer"
min = 0

[types.counts.speedup_pads]
type = "integer"
min = 0

[types.counts.weapon_pads]
type = "integer"
min = 0

# Written only when the track has art (ADR-0076).
[types.counts.art_meshes]
type = "integer"
min = 0
optional = true

# The art section (ADR-0076). Its numbers are render-side only, so they are
# decimal here: nothing simulates them. A reader also takes `2` for `2.0`.
[types.number]
oneof = ["integer", "float"]

[types.vec3]
type = "array"
itemtype = "types.number"
minlength = 3
maxlength = 3

[types.sun]
type = "table"

# Unit vector from the scene towards the sun.
[types.sun.direction]
type = "types.vec3"

# Linear RGB.
[types.sun.colour]
type = "types.vec3"

[types.sun.intensity]
type = "types.number"

# Degrees; 0 is a point sun.
[types.sun.angular_diameter]
type = "types.number"

[types.sun.shadows]
type = "boolean"

[types.lensflare]
type = "table"

[types.lensflare.colour]
type = "types.vec3"
optional = true

# An index into the `[[art.texture]]` rows.
[types.lensflare.atlas]
type = "integer"
min = 0
optional = true

# A texture row is exactly one of the two: the author's own picture beside the
# manifest, or a host title's circuit texture named by entry and node name.
[types.image-texture]
type = "table"

[types.image-texture.image]
type = "string"
minlength = 1

[types.host-reference]
type = "table"

[types.host-reference.entry]
type = "string"
minlength = 1

[types.host-reference.name]
type = "string"
minlength = 1

[types.host-texture]
type = "table"

[types.host-texture.host]
type = "types.host-reference"

[types.texture]
oneof = ["types.image-texture", "types.host-texture"]

[types.art]
type = "table"

# A host circuit's `.vex` entry whose `Skycube` is drawn.
[types.art.sky]
type = "string"
minlength = 1
optional = true

# Linear RGB.
[types.art.ambient]
type = "types.vec3"
optional = true

[types.art.sun]
type = "types.sun"
optional = true

[types.art.lensflare]
type = "types.lensflare"
optional = true

[types.art.texture]
type = "array"
itemtype = "types.texture"
optional = true

[elements]

[elements.toml-schema]
type = "types.toml-schema-reference"

[elements.track]
type = "types.track"

[elements.spline]
type = "types.spline"

[elements.counts]
type = "types.counts"

[elements.art]
type = "types.art"
optional = true
