# A mod's manifest, `oag-mod.toml` at the root of a folder, .zip or .oagmod:
# see crates/mod/src/manifest.rs and docs/tools/mods.md. What cannot be said here
# and stays the loader's: that `id` has the id shape, `version` is a semver release,
# `license` is an SPDX expression, `license-file` names a file in the mod, `oag` is
# a version requirement, and that exactly one of the two licence keys is present or
# neither (a mod with no licence loads and is marked "no license stated").

[toml-schema]
version = "1.0.0"

[types.toml-schema-reference]
type = "table"

[types.toml-schema-reference.location]
type = "string"
pattern = "/v1/mod[.]tosd$"

[types.toml-schema-reference.version]
type = "string"
allowedvalues = ["1.0.0"]

[types.mod]
type = "table"

[types.mod.id]
type = "string"

[types.mod.name]
type = "string"

[types.mod.version]
type = "string"

[types.mod.authors]
type = "array"
itemtype = "string"
minlength = 1

[types.mod.license]
type = "string"
optional = true

[types.mod.license-file]
type = "string"
optional = true

[types.mod.description]
type = "string"

[types.mod.repository]
type = "string"
optional = true

[types.mod.homepage]
type = "string"
optional = true

[types.mod.keywords]
type = "array"
itemtype = "string"
optional = true

[types.mod.titles]
type = "array"
itemtype = "string"
optional = true

# Titles (lowercased hyphenated names) whose disc the mod needs for what it draws. The mod
# loads without one; the mods page says which is missing.
[types.mod.needs-titles]
type = "array"
itemtype = "string"
optional = true

[types.mod.oag]
type = "string"
optional = true

# On until the player turns it off. Absent: true, except in a mod with a [texture-pack].
[types.mod.default-enabled]
type = "boolean"
optional = true

[elements]

[elements.toml-schema]
type = "types.toml-schema-reference"

[elements.mod]
type = "types.mod"

# `[extension]`: WebAssembly modules (docs/architecture/wasm-extensions/README.md,
# section 1.1). The loader checks that a rules module says `simulation = true` and
# names a file in the mod.
[types.extension]
type = "table"

[types.extension.simulation]
type = "boolean"
optional = true

[types.extension.api]
type = "integer"

[types.extension.memory_pages]
type = "integer"
optional = true

[types.extension.state_bytes]
type = "integer"
optional = true

[types.extension.drives_ai_pickup]
type = "boolean"
optional = true

[types.extension.rules]
type = "table"
optional = true

[types.extension.rules.module]
type = "string"

# One module bound to one track file of the mod; it runs only in a race of that file.
[types.extension.track]
type = "table"
optional = true

[types.extension.track.module]
type = "string"

[types.extension.track.track]
type = "string"

[elements.extension]
type = "types.extension"
optional = true

# `[channels]`: the event channels the mod's modules publish and listen to
# (docs/architecture/wasm-extensions/hooks.md, "Events between mods"). Each is a
# namespaced name, `<mod id>/<name>`; a published one starts with this mod's own id.
# The loader checks the shape, the namespace, repeats and hash collisions.
[types.channels]
type = "table"

[types.channels.publishes]
type = "array"
itemtype = "string"
optional = true

[types.channels.listens]
type = "array"
itemtype = "string"
optional = true

[elements.channels]
type = "types.channels"
optional = true

# `[icons]`: name = "path.png" or "path.svg". The keys are the author's, so the schema says
# "any"; the loader checks that every icon is a .png or .svg in the mod and every name is
# letters, digits, '-', '_'. An .svg is rasterised at load at the pixel size it is drawn at;
# a `<text>` node draws nothing and an `<image>` is never read. A mod's text is its `strings/<language>.toml`, not the manifest.

[elements.icons]
type = "any"
optional = true

# `[effects]`: name = "path.toml", the mod's own particle effects (effect.tosd). The
# loader checks the names (letters, digits, '-', '_') and that each is a .toml in the
# mod; the file itself is read, and refused by name, when a race loads it.

[elements.effects]
type = "any"
optional = true

# `[shaders]`: name = "path.wgsl", the mod's own fragment shaders, `.wgsl` or `.wesl`
# (docs/architecture/wasm-extensions/mod-shaders.md). The loader checks the names and that each
# is such a file in the mod; the file itself is read, and refused by name, when a race loads it.

[elements.shaders]
type = "any"
optional = true

# `[sounds]`: name = "path.wav", the mod's own sounds (PCM16, docs/formats/mod-sound.md).
# The loader checks the names and that each is a .wav in the mod; the file itself is read,
# and refused by name, when a race loads it.

[elements.sounds]
type = "any"
optional = true

# `[pickup]`: the look of the mod's own pickup, required of a simulation mod that hands
# one out (give-pickup, pickup-roll). Each of `icon` and `colour` names its source:
#   icon   = { title = "turbo" }  or  { mod = "<key of [icons]>" }
#   colour = { rgba = "E0202080" } or { title = "shield" }
# The loader checks that exactly one key is given, that a `title` is a weapon (turbo,
# shield, rocket, ...), that a `mod` is a key of [icons] and that `rgba` is RRGGBBAA hex.

[types.pickup]
type = "table"

[types.pickup.icon]
type = "table"

[types.pickup.icon.title]
type = "string"
optional = true

[types.pickup.icon.mod]
type = "string"
optional = true

[types.pickup.colour]
type = "table"

[types.pickup.colour.title]
type = "string"
optional = true

[types.pickup.colour.rgba]
type = "string"
optional = true

# `[[pickup.odds]]`: the weights the weapon pads draw the mod's own pickup with, beside
# the title's weapons (ai, human, front, back, as a title's <Pickupodds>). `title` (a
# lowercased hyphenated title name) and `class` (a pickup table's class, any case) are
# optional; the most specific row that matches a race is used. Weights finite, >= 0.

[types.pickup.odds]
type = "array"
itemtype = "types.pickup-odds"
optional = true

# `[pickup.titles.<title>]`: what differs on one title (its lowercased hyphenated name),
# the same `icon` and `colour` shapes, each over `[pickup]` for what it leaves out: a
# mod's own icon art per title. The loader checks the shapes as `[pickup]` does.

[types.pickup.titles]
type = "any"
optional = true

[types.pickup-odds]
type = "table"

[types.pickup-odds.title]
type = "string"
optional = true

[types.pickup-odds.class]
type = "string"
optional = true

[types.pickup-odds.ai]
type = "float"

[types.pickup-odds.human]
type = "float"

[types.pickup-odds.front]
type = "float"

[types.pickup-odds.back]
type = "float"

[elements.pickup]
type = "types.pickup"
optional = true

# `[campaign-medals]`: the art the campaign screens draw a medal with, in place of the
# title's colour swatch. `source` names the atlas:
#   source = { title = "hd" }  or  { mod = "<key of [icons]>" }
# `per-difficulty` says the atlas holds one block of tiers per difficulty. `tiers` names the
# tier of each atlas row, top to bottom (the names of the campaign's tiers: gold, silver, bronze
# or a `[[medal-tier]]` of its own, each once); a `title` source
# uses the title's own row order and ignores it. A `mod` source is a PNG cut into equal frames:
# `tiers` rows per block, three blocks (easy, medium, hard from the top) when `per-difficulty`. The loader checks that exactly one source
# key is given, that a `mod` is a key of [icons] and the tier names.

[types.campaign-medals]
type = "table"

[types.campaign-medals.source]
type = "table"

[types.campaign-medals.source.title]
type = "string"
optional = true

[types.campaign-medals.source.mod]
type = "string"
optional = true

[types.campaign-medals.per-difficulty]
type = "boolean"
optional = true

[types.campaign-medals.tiers]
type = "array"
itemtype = "string"
optional = true

[elements.campaign-medals]
type = "types.campaign-medals"
optional = true

# `[texture-pack]`: the mod is a PPSSPP texture pack (docs/tools/mods.md, "Texture packs").
# A folder or zip with a `textures.ini` and no manifest is recognised without one.
[types.texture-pack]
type = "table"

[types.texture-pack.format]
type = "string"
allowedvalues = ["ppsspp"]

[types.texture-pack.ini]
type = "string"
optional = true

[types.texture-pack.serials]
type = "array"
itemtype = "string"
optional = true

[elements.texture-pack]
type = "types.texture-pack"
optional = true
