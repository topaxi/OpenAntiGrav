pkgbase = openantigrav-git
	pkgdesc = Clean-room Rust reimplementation of the Studio Liverpool anti-gravity racing engine (Wipeout Pulse, Pure, HD, 2048, Omega); engine only, bring your own disc
	pkgver = r0.0000000
	pkgrel = 1
	url = https://github.com/topaxi/OpenAntiGrav
	arch = x86_64
	license = MIT
	license = Apache-2.0
	makedepends = cargo
	makedepends = clang
	makedepends = git
	makedepends = pkgconf
	depends = alsa-lib
	depends = glibc
	depends = libpipewire
	depends = systemd-libs
	depends = vulkan-icd-loader
	optdepends = vulkan-driver: a GPU driver (vulkan-radeon, vulkan-intel, nvidia-utils); vulkan-swrast gives a CPU adapter
	optdepends = ffmpeg: converts each game intro movie on first boot (without it the intro is a black screen)
	provides = openantigrav
	conflicts = openantigrav
	options = !lto
	source = git+https://github.com/topaxi/OpenAntiGrav.git
	sha256sums = SKIP

pkgname = openantigrav-git
