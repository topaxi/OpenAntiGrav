# Maintainer: Damian Senn <damian.senn@gmail.com>
#
# Builds the engine from source. No game content is packaged: the player
# supplies a disc image (docs/overview/installing.md).
pkgname=openantigrav-git
_pkgname=OpenAntiGrav
pkgver=r0.0000000
pkgrel=1
pkgdesc='Clean-room Rust reimplementation of the Studio Liverpool anti-gravity racing engine (Wipeout Pulse, Pure, HD, 2048, Omega); engine only, bring your own disc'
arch=('x86_64')
url='https://github.com/topaxi/OpenAntiGrav'
license=('MIT' 'Apache-2.0')
# libpipewire is a hard link-time dependency (cpal's PipeWire host) and
# alsa-lib its fallback. Vulkan, Wayland and X11 are loaded at run time.
depends=('alsa-lib' 'gcc-libs' 'glibc' 'libpipewire' 'systemd-libs' 'vulkan-icd-loader')
# Distro `cargo`, not rustup: the repository's rust-toolchain.toml pins 1.99.0
# for CI reproducibility, but Arch's `rust` is newer than the 1.97.1 MSRV
# (Cargo.toml rust-version) and a package must build with the packaged
# toolchain. clang provides libclang for the bindgen run in libspa-sys.
makedepends=('cargo' 'clang' 'git' 'pkgconf')
optdepends=('vulkan-driver: a GPU driver (vulkan-radeon, vulkan-intel, nvidia-utils); vulkan-swrast gives a CPU adapter'
            'ffmpeg: converts each game intro movie on first boot (without it the intro is a black screen)')
provides=('openantigrav')
conflicts=('openantigrav')
options=('!lto')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  # No tag exists yet: fall back to r<commit count>.<short hash>.
  if git describe --long --tags --match 'v*' >/dev/null 2>&1; then
    git describe --long --tags --match 'v*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p oag-game
}

package() {
  cd "$_pkgname"
  local bin=target/release/oag-game
  install -Dm755 "$bin" "$pkgdir/usr/bin/oag-game"
  install -Dm644 packaging/appimage/oag-game.desktop \
    "$pkgdir/usr/share/applications/oag-game.desktop"
  # The window icon is generated by the binary itself from assets/icons/64x64.svg.
  install -dm755 "$pkgdir/usr/share/icons/hicolor/256x256/apps"
  "$bin" --write-icon "$pkgdir/usr/share/icons/hicolor/256x256/apps/oag-game.png" --icon-size 256
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 licences/* -t "$pkgdir/usr/share/licenses/$pkgname/licences"
  install -Dm644 README.md docs/overview/installing.md -t "$pkgdir/usr/share/doc/$pkgname"
}
